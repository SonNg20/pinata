local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SaveModule = require(ReplicatedStorage:WaitForChild("Library"):WaitForChild("Client"):WaitForChild("Save"))
local KX_Release = ReplicatedStorage:WaitForChild("Network"):WaitForChild("KX_Release")
local LocalPlayer = Players.LocalPlayer
local VirtualUser = game:GetService("VirtualUser")

local RADIUS = 18
local DELAY = 0.5
local THREAD_COUNT = 1
local CHECK_INTERVAL = 0.5
local MAX_FAILS = 1000000

local isRunning = false
local giftUID = nil
local totalAmount = 0
local failCount = 0
local callCount = 0

local function getGiftInfo()
    local data = SaveModule.Get()
    if not data or not data.Inventory then return nil, 0 end
    for _, category in pairs(data.Inventory) do
        for uid, item in pairs(category) do
            local id = tostring(item.id):lower()
            if id:find("fiesta") and id:find("gift") then
                local amount = item._am or item.am or 1
                return uid, amount
            end
        end
    end
    return nil, 0
end

local function getPositionsAroundPlayer()
    local positions = {}
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then
        for i = 1, 8 do table.insert(positions, Vector3.new(0, 0, 0)) end
        return positions
    end
    local center = root.Position
    for i = 1, 8 do
        local angle = (i - 1) * math.pi / 4
        local r = RADIUS + (math.random() - 0.5) * 6
        local a = angle + (math.random() - 0.5) * 0.4
        local x = center.X + r * math.cos(a)
        local z = center.Z + r * math.sin(a)
        local y = center.Y
        table.insert(positions, Vector3.new(x, y, z))
    end
    return positions
end

-- ===== SỬA LOGIC BATCH =====
local function getBatchSize()
    if totalAmount >= 8 then
        return 8
    elseif totalAmount >= 1 then
        return totalAmount   -- mở hết số còn lại (1–7)
    else
        return 0
    end
end

local function openGift(amount)
    if amount <= 0 or not giftUID then return end
    local positions = getPositionsAroundPlayer()
    local args = {giftUID, amount, positions}
    
    local success = pcall(function()
        KX_Release:FireServer(unpack(args))
    end)
    if not success then
        pcall(function()
            KX_Release:InvokeServer(unpack(args))
        end)
    end
    totalAmount = totalAmount - amount
    callCount = callCount + 1
end

local function spamThread()
    while isRunning do
        local batch = getBatchSize()
        if batch <= 0 then break end
        openGift(batch)
        task.wait(DELAY)
    end
end

local function continuousCheck()
    while isRunning do
        task.wait(CHECK_INTERVAL)
        local _, newTotal = getGiftInfo()
        if newTotal == totalAmount then
            failCount = failCount + 1
            print(string.format("[CHECK] So luong khong doi (%d) - lan %d/%d", totalAmount, failCount, MAX_FAILS))
        else
            totalAmount = newTotal
            failCount = 0
            print("[CHECK] Con lai:", totalAmount)
        end
        if totalAmount <= 0 then
            isRunning = false
            print("Da mo het Fiesta Gift!")
            updateButton()
            break
        end
        if failCount >= MAX_FAILS then
            isRunning = false
            print("So luong khong giam sau " .. MAX_FAILS .. " lan kiem tra.")
            updateButton()
            break
        end
    end
end

local function startAuto()
    local uid, amount = getGiftInfo()
    if not uid or amount <= 0 then
        print("Khong co Fiesta Gift de mo.")
        return
    end
    giftUID = uid
    totalAmount = amount
    failCount = 0
    callCount = 0
    isRunning = true

    print(string.format("Start %d gift (UID: %s)", totalAmount, giftUID))
    print(string.format("So luong: %d, Delay: %s, Batch: %d (tu dong)", THREAD_COUNT, tostring(DELAY), getBatchSize()))

    for i = 1, THREAD_COUNT do
        task.spawn(spamThread)
    end
    task.spawn(continuousCheck)
    updateButton()
end

local function stopAuto()
    isRunning = false
    print("Da dung tu dong mo qua.")
    updateButton()
end

-- GUI
